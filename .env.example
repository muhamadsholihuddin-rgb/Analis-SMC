# Salin ke Environment Variables di dashboard Vercel (Settings > Environment Variables)
# JANGAN pernah commit API key asli ke Git.

# --- Opsi A: 1 API key saja (setup lama, tetap didukung) ---
# GEMINI_API_KEY=isi_dengan_api_key_pertama

# --- Opsi B: beberapa API key sekaligus, dipisah koma (DIREKOMENDASIKAN) ---
# Kalau key pertama kena limit 429 (quota habis), server otomatis coba key berikutnya.
GEMINI_API_KEYS=api_key_pertama,api_key_kedua,api_key_ketiga

# Opsional — default sudah gemini-3-flash-preview kalau dikosongkan.
# GEMINI_MODEL=gemini-3-flash-preview
